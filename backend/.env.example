# IMAP Configuration
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=dmarc@example.com
IMAP_PASSWORD=your_password_here

# Database Configuration
DATABASE_URL=file:./data.db

# Server Configuration
PORT=3000
NODE_ENV=development

# Passkeys (WebAuthn). All three default from PUBLIC_ORIGIN and the instance name, so a
# normal deployment only needs PUBLIC_ORIGIN set. A passkey is bound to one exact origin:
# if these are wrong, registration appears to work in the browser and every later sign-in
# silently fails verification, which is why the app disables passkeys (rather than
# guessing) when it cannot determine an origin.
# WEBAUTHN_ORIGIN=https://dmarc.example.com
# WEBAUTHN_RP_ID=dmarc.example.com
# WEBAUTHN_RP_NAME=DMARC Viewer

# Email processing schedule (optional overrides)
# Set to "false" to disable automatic email checks during development.
# Leave unset or set to "true" in production environments to enable the scheduler.
ENABLE_SCHEDULED_EMAIL_PROCESSING=false
# EMAIL_PROCESSING_INTERVAL_MS=300000
