{
  "name": "dmarc-report-viewer-backend",
  "version": "1.0.0",
  "description": "Backend service for DMARC report processing and API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx test/rufParser.test.ts && tsx test/tlsRptParser.test.ts && tsx test/dnssec.test.ts && tsx test/domainStatus.test.ts && tsx test/recordSuggestions.test.ts && tsx test/webauthn.test.ts && tsx test/oidc.test.ts && tsx test/sources.test.ts && tsx test/dnsApply.test.ts && tsx test/loopiaDns.test.ts && tsx test/alerts.test.ts && tsx test/tenancy.test.ts && tsx test/ingestion.test.ts && tsx test/dnsAccounts.test.ts",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/db/seed.ts",
    "process-emails": "tsx src/cli/processEmails.ts",
    "reparse": "node dist/cli/reparseArchive.js",
    "reparse:dev": "tsx src/cli/reparseArchive.ts",
    "dnssec": "tsx src/cli/dnssec.ts",
    "tlsrpt:import": "tsx src/cli/importTlsRpt.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/server": "^14.0.3",
    "@types/yauzl": "^3.4.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mailparser": "^3.9.40",
    "node-imap": "^0.9.6",
    "openid-client": "^6.8.8",
    "prisma": "^7.10.1",
    "xml2js": "^0.6.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/node-imap": "^0.9.3",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
