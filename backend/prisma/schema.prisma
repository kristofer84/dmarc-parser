// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Prisma 7: the generated client lives in src/ so tsc compiles it with the rest, and the
// imports it emits must carry a .js extension or Node ESM cannot resolve them.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

// `url` moved to prisma.config.ts in 7; leaving it here is a hard P1012 error.
datasource db {
  provider = "sqlite"
}

model Report {
  id              String   @id @default(cuid())
  domain          String
  reportId        String   @unique
  orgName         String
  email           String
  startDate       DateTime
  endDate         DateTime
  /// The published policy (policy_published), stored rather than dropped: the UI can then say
  /// what receivers were told to do. Null on rows ingested before these columns existed - the
  /// raw XML is not kept, so those cannot be backfilled.
  policyP         String?
  policySp        String?
  policyPct       Int?
  policyAdkim     String?
  policyAspf      String?
  /// The tenant and the mailbox row the report arrived through. Null on rows ingested before
  /// organisations existed (migration backfills the Default org).
  orgId           String?
  organization    Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  mailboxId       String?
  mailbox         OrgMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  records         Record[]
  processingLogs  ProcessingLog[]

  @@index([orgId, endDate])
  @@index([mailboxId])
  @@map("reports")
}

model Record {
  id              String   @id @default(cuid())
  reportId        String
  sourceIp        String
  count           Int
  disposition     String   // none, quarantine, reject
  dkim            String   // pass, fail
  spf             String   // pass, fail
  headerFrom      String
  /// auth_results/dkim and auth_results/spf as JSON text: [{ domain, result }]. The two columns
  /// above carry the policy-evaluated verdict; these say which domain and result the receiver
  /// actually saw, which is what turns "failed" into "signed by the wrong domain".
  dkimAuth        String   @default("[]")
  spfAuth         String   @default("[]")

  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("records")
}

model ProcessingLog {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  messageUid      Int?
  attachmentName  String?
  status          String
  details         String?
  reportId        String?
  report          Report?   @relation(fields: [reportId], references: [id])
  forensicReportId String?
  forensicReport  ForensicReport? @relation(fields: [forensicReportId], references: [id])
  /// Tenant/mailbox the attachment was fetched from; drives the processing-log scope.
  orgId           String?
  organization    Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  mailboxId       String?
  mailbox         OrgMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([orgId, createdAt])
  @@map("processing_logs")
}

/// Forensic (RUF) reports - per-message authentication failures, RFC 5965 / RFC 7489 7.2.
/// Unlike aggregate reports these describe individual messages, so one mail can produce one row.
model ForensicReport {
  id                  String    @id @default(cuid())
  /// Dedup key: the report mail's Message-ID when present, else a hash of the identifying fields.
  dedupKey            String    @unique
  /// The domain the report is about (Reported-Domain).
  domain              String
  reportedDomain      String?
  /// Best-effort identity of the reporting organisation.
  reporter            String?
  reporterEmail       String?
  reportingMta        String?
  feedbackType        String
  reportVersion       String?
  userAgent           String?
  arrivalDate         DateTime?
  sourceIp            String?
  originalMailFrom    String?
  originalRcptTo      String?
  originalEnvelopeId  String?
  incidents           String?
  /// Parsed out of Authentication-Results - dmarc is often absent in RUF.
  spfResult           String?
  dkimResult          String?
  dmarcResult         String?
  authResults         String?
  dkimDomain          String?
  dkimIdentity        String?
  dkimSelector        String?
  identityAlignment   String?
  /// Identifying headers of the reported message (always kept).
  reportedFrom        String?
  reportedTo          String?
  reportedSubject     String?
  reportedDate        DateTime?
  reportedMessageId   String?
  /// Full header block of the reported message - only when forensic.storeFullHeaders is enabled.
  reportedHeaders     String?
  /// Plain-text body of the reported message, truncated - only when forensic.storeReportedMessage is enabled.
  reportedBody        String?
  /// Raw feedback-report block - only when forensic.storeRawFeedback is enabled.
  rawFeedback         String?
  /// Whether the report mail itself authenticated (DKIM per mailparser). The mailbox is
  /// world-writable, so an unauthenticated report is a claim, not a fact.
  reportAuthenticated Boolean   @default(false)
  reportAuthDetail    String?
  sourceMessageId     String?
  sourceMessageUid    Int?
  /// Tenant/mailbox that ingested the report; see Report.
  orgId               String?
  organization        Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  mailboxId           String?
  mailbox             OrgMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  processingLogs      ProcessingLog[]

  @@index([domain])
  @@index([arrivalDate])
  @@index([sourceIp])
  @@index([createdAt])
  @@index([orgId, createdAt])
  @@map("forensic_reports")
}

/// Append-only record of security-relevant actions: who did what, when, from where, and
/// whether it worked. Deliberately NOT foreign-keyed to User - deleting an account must not
/// delete the evidence of what that account did, so the actor is kept as text.
///
/// `orgId` is the tenant the action was taken in; null for instance-level actions (settings,
/// providers) and for rows written before organisations existed.
model AuditEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  orgId     String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  /// Email address of the actor, or 'anonymous' / 'system'.
  actor     String
  actorId   String?
  /// Dotted, stable identifier, e.g. 'auth.login' or 'settings.update'.
  action    String
  /// success | failure
  outcome   String   @default("success")
  /// What the action was applied to: a user email, domain, setting key or record id.
  target    String?
  ip        String?
  userAgent String?
  /// JSON object as text. Passwords, secrets and tokens are redacted before write.
  detail    String?

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actor, createdAt])
  @@index([orgId, createdAt])
  @@map("audit_events")
}

/// TLS-RPT (RFC 8460) aggregate report, one row per policy entry: a single report can cover
/// several policy domains and MX hosts, and each carries its own success/failure counts.
model TlsRptReport {
  id              String   @id @default(cuid())
  /// report-id + policy domain + MX host. A resend keeps the same key, so ingestion is idempotent.
  dedupKey        String   @unique
  reportId        String?
  orgName         String?
  contactInfo     String?
  dateBegin       DateTime
  dateEnd         DateTime
  policyDomain    String
  /// sts | tlsa | no-policy-found
  policyType      String
  mxHost          String
  successfulCount Int      @default(0)
  failureCount    Int      @default(0)
  /// JSON array of failure-detail objects: result-type, failed count, sending MTA IP and
  /// the reporter's reason code. This is the part that says *why* TLS failed.
  failureDetails  String   @default("[]")
  /// The policy the reporter fetched, as JSON array of lines - evidence of what was live then.
  policyString    String?
  /// Raw report JSON, size-capped. The record of what the reporter actually sent.
  raw             String?
  /// Tenant/mailbox that ingested the report; see Report.
  orgId           String?
  organization    Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  mailboxId       String?
  mailbox         OrgMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([policyDomain, dateEnd])
  @@index([createdAt])
  @@index([orgId, createdAt])
  @@map("tls_rpt_reports")
}

/// One thing an operator should look at: a sender never seen before for a domain, or a failure
/// rate above the configured threshold. `dedupKey` is what makes the recurring scan idempotent -
/// the same finding is recorded once, not every fifteen minutes. Acknowledging is the only
/// mutation the UI performs; the evidence itself lives in reports/records.
model Alert {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  orgId          String?
  organization   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  /// new_source | failure_spike
  kind           String
  /// info | warning | critical
  severity       String    @default("warning")
  domain         String
  sourceIp       String?
  title          String
  /// JSON object as text: the numbers behind the finding, so the UI need not recompute them.
  detail         String?
  dedupKey       String    @unique
  acknowledgedAt DateTime?
  acknowledgedBy String?
  /// Set when the webhook accepted the POST; null means no webhook is configured or it failed.
  deliveredAt    DateTime?

  @@index([createdAt])
  @@index([domain, createdAt])
  @@index([acknowledgedAt])
  @@index([orgId, createdAt])
  @@map("alerts")
}

/// Runtime application options, editable from the admin UI.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("settings")
}

/// A console user. `role` is 'admin' (sees everything, manages users and settings)
/// or 'user', which sees only the domains assigned in UserDomain.
model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  name                     String?
  passwordHash             String
  role                     String    @default("user")
  isActive                 Boolean   @default(true)
  mustChangePassword       Boolean   @default(false)
  failedLoginCount         Int       @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  /// When this account said "not now" to the "add a passkey" prompt. Stored per account,
  /// not per browser, so the prompt does not reappear when someone signs in elsewhere.
  passkeyPromptDismissedAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  sessions            Session[]
  domains             UserDomain[]
  webauthnCredentials WebAuthnCredential[]
  identities          UserIdentity[]
  memberships         Membership[]

  @@map("users")
}

/// A tenant. Users join through Membership; every domain belongs to exactly one organisation
/// (null on a domain discovered from a report but not yet assigned). The instance superadmin
/// (`User.role = 'admin'`) sees all organisations.
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  domains     Domain[]
  dnsAccounts DnsAccount[]
  mailboxes   OrgMailbox[]
  reports     Report[]
  forensics   ForensicReport[]
  tlsRpt      TlsRptReport[]
  processingLogs ProcessingLog[]
  alerts      Alert[]
  auditEvents AuditEvent[]

  @@map("organizations")
}

/// One IMAP mailbox belonging to an organisation. An org can have several (one per brand or
/// customer). Credentials are stored like the legacy mailbox password and are never returned by
/// the API. Reports ingested through this row carry its `mailboxId` and the org's `orgId`.
model OrgMailbox {
  id          String   @id @default(cuid())
  orgId       String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label       String
  host        String
  port        Int      @default(993)
  user        String
  password    String
  verifyTls   Boolean  @default(true)
  enabled     Boolean  @default(true)
  /// Last ingestion attempt and its outcome, so the org admin can see a dead mailbox.
  lastRunAt   DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports         Report[]
  forensics       ForensicReport[]
  tlsRpt          TlsRptReport[]
  processingLogs  ProcessingLog[]

  @@unique([orgId, label])
  @@index([orgId])
  @@map("org_mailboxes")
}

/// A user's role inside one organisation. `admin` may edit that org's members, domains, DNS
/// accounts and alerts; `viewer` reads. Instance-wide administration stays on `User.role`.
model Membership {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// admin | viewer
  role      String       @default("viewer")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

/// An external single-sign-on provider (OIDC). Passwords and passkeys stay the fallback:
/// disabling or deleting a provider never removes an account, only one way into it.
model AuthProvider {
  id                 String   @id @default(cuid())
  name               String
  type               String   @default("oidc")
  enabled            Boolean  @default(true)
  issuer             String
  clientId           String
  clientSecret       String
  scopes             String   @default("openid email profile")
  allowAutoProvision Boolean  @default(true)
  /// Some providers never send `email_verified` at all - Microsoft Entra ID v2.0 among them -
  /// even though the address comes from the directory rather than the user. With this on, an
  /// *absent* marker is accepted as verified for this provider. An explicit `email_verified:
  /// false` is never overridden. Off by default so the strict rule stays the default.
  trustUnverifiedEmail Boolean @default(false)
  /// JSON array as text; assigned only to users this provider creates.
  defaultDomains     String   @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  identities         UserIdentity[]

  @@map("auth_providers")
}

/// A user's account at an external provider. Kept separate from User so one account can be
/// reachable through several providers later without another schema change.
model UserIdentity {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId  String
  provider    AuthProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  subject     String
  email       String?
  createdAt   DateTime     @default(now())
  lastLoginAt DateTime?

  @@unique([providerId, subject])
  @@index([userId])
  @@map("user_identities")
}

/// A passkey (WebAuthn credential) belonging to a user. Passwords remain the fallback, so a
/// user with no rows here - or with every row cleared by an administrator - can still sign in.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique   // base64url, as returned by the library
  publicKey    String               // base64url
  counter      Int       @default(0)
  transports   String    @default("[]")  // JSON array (SQLite has no array column here)
  label        String?              // what the user calls the device
  deviceType   String?              // 'singleDevice' | 'multiDevice'
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("webauthn_credentials")
}

/// Opaque server-side sessions. Only the SHA-256 of the cookie token is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Which domains a non-admin user may see.
model UserDomain {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain    String
  createdAt DateTime @default(now())

  @@unique([userId, domain])
  @@index([domain])
  @@map("user_domains")
}

/// A domain whose mail authentication is checked (MX, SPF, DMARC, DKIM, MTA-STS, ...).
/// Domains are discovered from the reports that arrive, or added by an administrator.
model Domain {
  id            String        @id @default(cuid())
  name          String        @unique
  /// JSON array as text: SQLite has no JSON column type here, and the list is tiny.
  dkimSelectors String        @default("[]")
  expectedMx    String        @default("[]")
  monitored     Boolean       @default(true)
  notes         String?
  /// Which DNS account "Apply to DNS" writes through. Null means auto: use any enabled
  /// account that holds the domain (and, for backwards compatibility, environment settings).
  dnsAccountId  String?
  dnsAccount    DnsAccount?   @relation(fields: [dnsAccountId], references: [id], onDelete: SetNull)
  /// The tenant that owns this domain. Null until assigned (auto-discovered, or created by a
  /// superadmin without an org). Every report read is scoped through this relation.
  orgId         String?
  organization  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  /// How the domain became owned: report (first ingestion), manual (org admin), migration
  /// (Default org), or admin (superadmin assignment). Null while unowned.
  claimedAt     DateTime?
  claimSource   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  checks        DomainCheck[]

  @@index([dnsAccountId])
  @@index([orgId])
  @@map("domains")
}

/// A named set of DNS-provider credentials, assignable per domain.
///
/// `credentials` is JSON text because the two providers need different fields:
/// Cloudflare `{ token }`, Loopia `{ username, password }`. It is never returned by the API -
/// serialization exposes only whether a credential is stored - and it is never written to a log.
/// The row is admin-managed, like the OIDC client secret and the mailbox password.
model DnsAccount {
  id          String   @id @default(cuid())
  orgId       String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label       String
  /// cloudflare | loopia
  provider    String
  enabled     Boolean  @default(true)
  credentials String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domains     Domain[]

  @@unique([orgId, label])
  @@index([orgId])
  @@map("dns_accounts")
}

/// One run of the checks, kept so the UI can show what changed since last time.
model DomainCheck {
  id          String   @id @default(cuid())
  domainId    String
  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  status      String
  runAt       DateTime @default(now())
  durationMs  Int
  /// The results array from the check report, as JSON text.
  resultsJson String

  @@index([domainId, runAt])
  @@map("domain_checks")
}
