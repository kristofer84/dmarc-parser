// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Report {
  id              String   @id @default(cuid())
  domain          String
  reportId        String   @unique
  orgName         String
  email           String
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  records         Record[]
  processingLogs  ProcessingLog[]

  @@map("reports")
}

model Record {
  id              String   @id @default(cuid())
  reportId        String
  sourceIp        String
  count           Int
  disposition     String   // none, quarantine, reject
  dkim            String   // pass, fail
  spf             String   // pass, fail
  headerFrom      String

  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("records")
}

model ProcessingLog {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  messageUid      Int?
  attachmentName  String?
  status          String
  details         String?
  reportId        String?
  report          Report?   @relation(fields: [reportId], references: [id])
  forensicReportId String?
  forensicReport  ForensicReport? @relation(fields: [forensicReportId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@map("processing_logs")
}

/// Forensic (RUF) reports - per-message authentication failures, RFC 5965 / RFC 7489 7.2.
/// Unlike aggregate reports these describe individual messages, so one mail can produce one row.
model ForensicReport {
  id                  String    @id @default(cuid())
  /// Dedup key: the report mail's Message-ID when present, else a hash of the identifying fields.
  dedupKey            String    @unique
  /// The domain the report is about (Reported-Domain).
  domain              String
  reportedDomain      String?
  /// Best-effort identity of the reporting organisation.
  reporter            String?
  reporterEmail       String?
  reportingMta        String?
  feedbackType        String
  reportVersion       String?
  userAgent           String?
  arrivalDate         DateTime?
  sourceIp            String?
  originalMailFrom    String?
  originalRcptTo      String?
  originalEnvelopeId  String?
  incidents           String?
  /// Parsed out of Authentication-Results - dmarc is often absent in RUF.
  spfResult           String?
  dkimResult          String?
  dmarcResult         String?
  authResults         String?
  dkimDomain          String?
  dkimIdentity        String?
  dkimSelector        String?
  identityAlignment   String?
  /// Identifying headers of the reported message (always kept).
  reportedFrom        String?
  reportedTo          String?
  reportedSubject     String?
  reportedDate        DateTime?
  reportedMessageId   String?
  /// Full header block of the reported message - only when forensic.storeFullHeaders is enabled.
  reportedHeaders     String?
  /// Plain-text body of the reported message, truncated - only when forensic.storeReportedMessage is enabled.
  reportedBody        String?
  /// Raw feedback-report block - only when forensic.storeRawFeedback is enabled.
  rawFeedback         String?
  /// Whether the report mail itself authenticated (DKIM per mailparser). The mailbox is
  /// world-writable, so an unauthenticated report is a claim, not a fact.
  reportAuthenticated Boolean   @default(false)
  reportAuthDetail    String?
  sourceMessageId     String?
  sourceMessageUid    Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  processingLogs      ProcessingLog[]

  @@index([domain])
  @@index([arrivalDate])
  @@index([sourceIp])
  @@index([createdAt])
  @@map("forensic_reports")
}

/// Runtime application options, editable from the admin UI.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("settings")
}

/// A console user. `role` is 'admin' (sees everything, manages users and settings)
/// or 'user', which sees only the domains assigned in UserDomain.
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  passwordHash       String
  role               String    @default("user")
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions           Session[]
  domains            UserDomain[]

  @@map("users")
}

/// Opaque server-side sessions. Only the SHA-256 of the cookie token is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Which domains a non-admin user may see.
model UserDomain {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain    String
  createdAt DateTime @default(now())

  @@unique([userId, domain])
  @@index([domain])
  @@map("user_domains")
}
