# Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# IMAP Configuration
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=dmarc@example.com
IMAP_PASSWORD=your_password_here

# Scheduled mail processing (optional, enabled by default every 300s)
# ENABLE_SCHEDULED_EMAIL_PROCESSING=true
# EMAIL_PROCESSING_INTERVAL_MS=300000

# First administrator, created on first start when the users table is empty.
# If ADMIN_PASSWORD is omitted a random password is generated and printed to the logs once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Public origin(s) allowed to call the API from a browser, comma-separated.
# Only needed when the frontend is served from a different host than the API;
# a frontend proxied through the same hostname works without it.
PUBLIC_ORIGIN=https://dmarc.example.com

# Force the Secure flag on the session cookie (automatic when the request is https).
# COOKIE_SECURE=true

# Optional: token used by the "Apply to DNS" action for zones hosted at Cloudflare.
# Needs Zone -> DNS -> Edit on those zones. When set, it takes precedence over the
# token stored under Administration -> Settings; leaving both empty keeps the
# copy-paste path and disables nothing else.
# CLOUDFLARE_API_TOKEN=

# Optional: Loopia XML-RPC API user (not the customer login) and its password.
# Account -> API user, e.g. pi@loopiaapi. The account must hold the domains you
# want to write to. Environment values win over the settings page; Loopia
# rate-limits per minute, and the app retries twice before asking you to wait.
# LOOPIA_API_USER=pi@loopiaapi
# LOOPIA_API_PASS=
